{
  "name": "matiq-companion",
  "productName": "MatiQ Companion",
  "version": "0.1.1",
  "private": true,
  "description": "A local AI workspace by MatiQ Solutions.",
  "author": "MatiQ Inc",
  "main": "src/main.cjs",
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "start": "npm run native:build && electron .",
    "test": "node --test test/*.test.cjs",
    "test:desktop": "npm run native:build && node scripts/desktop-test.cjs",
    "test:inference": "node scripts/inference-test.mjs",
    "package": "npm run native:build && electron-builder --publish never",
    "package:dir": "npm run native:build && electron-builder --dir --publish never",
    "test:tools": "node scripts/tool-inference-test.cjs",
    "test:computer": "npm run native:build && node scripts/computer-test.cjs",
    "test:packaged": "node scripts/packaged-test.cjs",
    "package:release": "npm run native:build && node scripts/release.cjs",
    "test:signatures": "node scripts/verify-mac-signing.mjs",
    "test:upgrade": "node scripts/upgrade-test.cjs",
    "native:build": "node scripts/build-computer.cjs"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "1.0.0",
    "@xmldom/xmldom": "0.9.12",
    "adm-zip": "0.6.1",
    "docx": "9.15.2",
    "electron-updater": "6.8.9",
    "exceljs": "4.4.0",
    "node-llama-cpp": "3.22.3",
    "tesseract.js": "6.0.1",
    "@matiq-solutions/runtime": "https://github.com/GoMatiQ-inc/matiq-solutions/releases/download/sdk-v0.1.0/matiq-solutions-runtime-0.1.0.tgz",
    "@matiq-solutions/shell": "https://github.com/GoMatiQ-inc/matiq-solutions/releases/download/sdk-v0.1.0/matiq-solutions-shell-0.1.0.tgz"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "playwright": "1.64.1",
    "js-yaml": "4.3.2",
    "@nut-tree-fork/nut-js": "4.2.6",
    "node-gyp": "12.4.0"
  },
  "build": {
    "appId": "com.matiq.companion",
    "asar": true,
    "files": [
      "src/**/*",
      "package.json",
      "LICENSE",
      "NOTICE",
      "docs/MODELS.md",
      "matiq-tool.json"
    ],
    "asarUnpack": [
      "node_modules/node-llama-cpp/**/*",
      "node_modules/@node-llama-cpp/**/*",
      "node_modules/**/*.node",
      "node_modules/**/*.dll",
      "node_modules/**/*.dylib",
      "node_modules/**/*.so*",
      "node_modules/@tesseract.js-data/**/*",
      "node_modules/tesseract.js-core/**/*",
      "src/native/*.node"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSScreenCaptureUsageDescription": "MatiQ Companion reads the selected screen only after you approve a computer observation.",
        "NSAppleEventsUsageDescription": "MatiQ Companion controls apps only for approved computer actions."
      },
      "artifactName": "MatiQ-Companion-${version}-mac-${arch}.${ext}",
      "identity": "-",
      "minimumSystemVersion": "14.2"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "MatiQ-Companion-${version}-windows-${arch}.${ext}",
      "signtoolOptions": {
        "publisherName": "MatiQ Inc"
      }
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": false
    },
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "GoMatiQ-inc",
        "repo": "matiq-companion"
      }
    ],
    "npmRebuild": false
  }
}
