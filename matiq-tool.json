{
  "schema": 1,
  "id": "com.matiq.companion",
  "name": "MatiQ Companion",
  "description": "Chat with local models, attach files and choose the tools each conversation can use.",
  "version": "0.1.3",
  "sdk": 1,
  "dataVersion": 1,
  "runtime": "electron-45.2.3",
  "targets": [
    "darwin-arm64",
    "darwin-x64",
    "win32-x64",
    "win32-arm64",
    "linux-x64"
  ],
  "capabilities": [
    "files",
    "network",
    "computer"
  ],
  "adapter": "src/suite.cjs",
  "workspace": "src/ui/index.html",
  "preload": "src/preload.cjs"
}
